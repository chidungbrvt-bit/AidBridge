# Default is the real same-origin API proxy. Never commit real credentials.
NEXT_PUBLIC_API_MODE=real
# Set the backend origin before npm run build; changing it requires a rebuild.
API_INTERNAL_BASE_URL=http://127.0.0.1:8081
# For isolated mock tests set NEXT_PUBLIC_API_MODE=mock and restart/rebuild.
# SESSION_COOKIE_SECURE=false belongs only in the local HTTP BACKEND environment.
